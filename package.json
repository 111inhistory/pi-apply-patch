{
	"name": "pi-apply-patch",
	"version": "0.5.0",
	"description": "Standalone V4A apply_patch editing tool for Pi with compaction fileOps tracking and native edit-style diff rendering.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run build && npm test",
		"prepack": "npm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"tools",
		"apply-patch"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/111inhistory/pi-apply-patch.git"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"diff": "^9.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.6.0",
		"@earendil-works/pi-tui": ">=1.6.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.6.0",
		"@earendil-works/pi-tui": "^1.6.0",
		"@types/node": "^22.19.19",
		"typebox": "^1.3.27",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
